---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBar from '../components/CtaBar.astro';

const SITE = (await import('../consts')).SITE;
interface Props { title: string; description: string; image?: string; }
const { title, description, image = '/og/home.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, SITE.url).href} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index,follow" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CtaBar />
  </body>
</html>
