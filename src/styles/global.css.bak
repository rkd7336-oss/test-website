:root{
  --green:#16352c; --green-2:#1f4a3d; --green-3:#2e665a;
  --lime:#d9efc8; --lime-2:#eef7e4;
  --paper:#f6f4ee; --card:#fff; --ink:#16201c; --muted:#5d6b64;
  --line:#e4e4da; --gold:#c8a15a;
  --radius:22px; --radius-sm:14px;
  --shadow:0 24px 60px rgba(22,53,44,.10);
  --maxw:1140px;
  --font:"Pretendard Variable",Pretendard,system-ui,-apple-system,"Segoe UI","Noto Sans KR",sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);word-break:keep-all;line-height:1.65;letter-spacing:-.022em;padding-bottom:82px;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
h1,h2,h3,p{margin:0}
h2{font-size:clamp(1.6rem,3vw,2.35rem);font-weight:800;letter-spacing:-.045em;line-height:1.2}
h3{font-weight:750;letter-spacing:-.03em}
main{max-width:var(--maxw);margin:0 auto;padding:0 22px}

/* Header */
.site-header{position:sticky;top:0;z-index:80;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:13px 22px;background:rgba(246,244,238,.86);backdrop-filter:blur(16px);border-bottom:1px solid rgba(22,53,44,.09)}
.logo{font-weight:900;color:var(--green);letter-spacing:-.05em;font-size:1.12rem;white-space:nowrap}
nav{display:flex;align-items:center;gap:6px}
nav a{padding:9px 13px;border-radius:999px;color:var(--muted);font-weight:700;font-size:.92rem;transition:.2s}
nav a:hover{color:var(--green);background:#fff}
nav a.nav-cta{background:var(--green);color:#fff;margin-left:4px}
nav a.nav-cta:hover{background:var(--green-2)}

/* Hero */
.hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);align-items:center;gap:40px;margin-top:32px;background:#fff;border:1px solid var(--line);border-radius:34px;overflow:hidden;box-shadow:var(--shadow)}
.hero-copy{padding:clamp(34px,5vw,62px)}
.eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--lime-2);color:var(--green);border:1px solid #cddebd;font-size:.78rem;font-weight:800;padding:8px 13px;border-radius:999px;letter-spacing:.02em}
.eyebrow::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--green-3)}
.hero h1{font-size:clamp(2.35rem,5.6vw,4.05rem);font-weight:900;letter-spacing:-.065em;line-height:1.07;margin:20px 0 18px}
.hero h1 em{font-style:normal;color:var(--green-3)}
.hero-lead{color:var(--muted);font-size:1.07rem;max-width:34em}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:54px;padding:14px 23px;border-radius:999px;background:var(--green);color:#fff;font-weight:800;font-size:1rem;transition:transform .2s,background .2s;box-shadow:0 14px 28px rgba(22,53,44,.16)}
.btn:hover{transform:translateY(-2px);background:var(--green-2)}
.btn.ghost{background:#fff;color:var(--green);border:1.5px solid #cfdac7;box-shadow:none}
.btn.ghost:hover{border-color:var(--green)}
.hero-side{position:relative;min-height:430px;background:linear-gradient(160deg,var(--green),var(--green-3));color:#fff;display:flex;flex-direction:column;justify-content:flex-end;padding:32px}
.hero-side::before{content:"";position:absolute;right:-70px;top:-90px;width:260px;height:260px;border-radius:50%;background:rgba(255,255,255,.07)}
.hero-side::after{content:"";position:absolute;left:-50px;bottom:-70px;width:190px;height:190px;border-radius:50%;background:rgba(255,255,255,.05)}
.hero-side strong{display:block;font-size:clamp(1.5rem,2vw,2rem);font-weight:850;letter-spacing:-.045em;position:relative}
.hero-side small{color:#dff0e7;font-weight:650;margin-top:10px;position:relative}
.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0 28px;position:relative}
.stat{background:rgba(255,255,255,.11);border:1px solid rgba(255,255,255,.15);border-radius:16px;padding:14px}
.stat b{display:block;font-size:1.3rem;letter-spacing:-.05em}
.stat span{font-size:.74rem;color:#dff0e7;font-weight:650}

/* Sections */
.section{padding:74px 0 14px}
.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:28px;margin-bottom:28px}
.section-heading p{color:var(--muted);max-width:34em;font-size:1.02rem}
.kicker{color:var(--green-3);font-weight:850;font-size:.8rem;letter-spacing:.13em;text-transform:uppercase;margin-bottom:9px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.grid.two{grid-template-columns:repeat(2,1fr)}
.grid.four{grid-template-columns:repeat(4,1fr)}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px;transition:transform .22s,box-shadow .22s}
.card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.card .num{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:13px;background:var(--lime-2);color:var(--green);font-weight:850;margin-bottom:16px}
.card h3{font-size:1.16rem;margin-bottom:8px}
.card p{margin:0;color:var(--muted);font-size:.96rem}

/* Process + info */
.process{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.step{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px}
.step b{color:var(--green);font-size:.8rem;font-weight:850}
.step h3{margin:12px 0 7px;font-size:1.08rem}
.step p{margin:0;color:var(--muted);font-size:.95rem}
.info{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;display:grid;grid-template-columns:auto 1fr;gap:13px 20px}
.info dt{font-weight:850;color:var(--green)}
.info dd{margin:0;color:#40514a}
.info dd a{text-decoration:underline;text-underline-offset:4px;font-weight:700}

/* Dark band */
.band{background:linear-gradient(120deg,var(--green),var(--green-2));color:#fff;border-radius:32px;padding:clamp(36px,5vw,58px);margin:74px 0 10px}
.band h2{color:#fff}
.band .kicker{color:#d9efc8}
.band p{color:#dcecdf}
.band .grid{margin-top:28px}
.band .card{background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.13)}
.band .card p{color:#d9e7de}
.band .card .num{background:rgba(255,255,255,.14);color:#fff}

/* Pricing */
.price-list{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.price-row{display:grid;grid-template-columns:1fr auto;gap:16px;padding:24px 28px;border-bottom:1px solid var(--line);align-items:center}
.price-row:last-child{border-bottom:0}
.price-row .amount{font-weight:900;color:var(--green);font-size:1.2rem;letter-spacing:-.04em}
.price-row small{display:block;color:var(--muted);margin-top:4px}

/* Other pages */
.hero.compact{display:block;min-height:0;margin-top:30px;box-shadow:none}
.hero.compact .hero-copy{padding:clamp(36px,5vw,52px)}
.hero.compact .hero-lead{margin:0}
.note{background:var(--lime-2);border:1px solid #cddebd;color:var(--green);border-radius:var(--radius-sm);padding:17px 20px;font-weight:650;font-size:.96rem}

/* Footer / CTA */
.site-footer{margin-top:74px;padding:40px 22px 34px;background:var(--green);color:#dcecdf;text-align:center;font-size:.92rem}
.site-footer a{color:#fff;text-decoration:underline;text-underline-offset:4px}
.site-footer .brandline{color:#fff;font-weight:850;font-size:1.1rem;letter-spacing:-.04em;margin-bottom:8px}
.cta-bar{position:fixed;left:0;right:0;bottom:0;z-index:90;display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(22,53,44,.2);box-shadow:0 -10px 34px rgba(22,53,44,.13)}
.cta{display:flex;align-items:center;justify-content:center;gap:8px;min-height:64px;background:#fff;color:var(--green);font-weight:850;text-decoration:none}
.cta.call{background:var(--green);color:#fff}
.cta.talk{background:#fff}
.cta::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;opacity:.65}

details{background:#fff;border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px 20px;margin-bottom:10px}
summary{font-weight:750;cursor:pointer}
summary::marker{color:var(--green)}

@media(max-width:960px){
  .grid,.process,.grid.four,.grid.two{grid-template-columns:1fr 1fr}
  .hero{grid-template-columns:1fr}
  .hero-side{min-height:300px}
  .section-heading{display:block}
  .section-heading p{margin-top:10px}
}
@media(max-width:680px){
  body{padding-bottom:70px}
  .site-header{padding:11px 16px}
  .logo{font-size:.98rem}
  nav{overflow-x:auto;scrollbar-width:none;max-width:74%;justify-content:flex-start}
  nav::-webkit-scrollbar{display:none}
  nav a{white-space:nowrap;padding:7px 10px;font-size:.82rem}
  main{padding:0 15px}
  .hero,.band,.info{border-radius:24px}
  .hero{margin-top:20px}
  .hero-copy{padding:28px 20px 25px}
  .hero h1{font-size:2.1rem}
  .hero-side{padding:24px 18px;min-height:250px}
  .hero-stats{grid-template-columns:repeat(3,1fr);margin-bottom:20px}
  .stat{padding:10px;border-radius:12px}
  .stat b{font-size:1.05rem}
  .section{padding:54px 0 8px}
  .grid,.process,.grid.two,.grid.four{grid-template-columns:1fr}
  .price-row{padding:19px 18px}
  .info{grid-template-columns:1fr;gap:4px}
  .info dd{margin-bottom:13px}
  .cta{min-height:58px;font-size:.95rem}
}
@media(max-width:390px){
  .hero-stats{gap:6px}
  .stat span{font-size:.66rem}
}
