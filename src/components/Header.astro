---
const SITE = (await import('../consts')).SITE;
const links = [
  { href: '/', label: '홈' },
  { href: '/포천PT/', label: 'PT' },
  { href: '/포천헬스/', label: '포천 헬스' },
  { href: '/송우리헬스장/', label: '송우리 헬스장' },
  { href: '/송우리PT/', label: '송우리 PT' },
];
---
<header class="site-header">
  <a class="logo" href="/">NATURALBOX<small>{SITE.shortName}</small></a>
  <nav>
    {links.map(l => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>


